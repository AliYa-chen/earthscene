{
  "name": "leva-vanilla",
  "version": "0.1.1-earthscene.1",
  "private": true,
  "description": "Vendored native control panel source for EarthScene examples.",
  "type": "module",
  "license": "MIT",
  "author": "Alkebsi",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./gui": {
      "types": "./src/dom/gui.ts",
      "import": "./src/dom/gui.ts"
    },
    "./src/core/types": {
      "types": "./src/core/types.ts",
      "import": "./src/core/types.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "UPSTREAM.json"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
